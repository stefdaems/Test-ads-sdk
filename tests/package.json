{
  "name": "ad-sdk-device-tests",
  "version": "1.0.0",
  "description": "Appium-based cross-platform tests for the ad SDK device lab",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:consent": "wdio run wdio.conf.js --spec consent/",
    "test:network": "wdio run wdio.conf.js --spec network/",
    "test:viewability": "wdio run wdio.conf.js --spec viewability/",
    "test:memory": "wdio run wdio.conf.js --spec memory/"
  },
  "devDependencies": {
    "@wdio/cli": "^8.0.0",
    "@wdio/local-runner": "^8.0.0",
    "@wdio/mocha-framework": "^8.0.0",
    "@wdio/spec-reporter": "^8.0.0",
    "appium": "^2.0.0",
    "appium-uiautomator2-driver": "^2.0.0",
    "appium-xcuitest-driver": "^5.0.0"
  }
}
